/dts-v1/;
#include "rk3576-radxa-nx4.dtsi"

/ {
	model = "Radxa C200 NX4 IO Board";
	compatible = "radxa,nx4-c200", "radxa,nx4", "rockchip,rk3576";

	vcc_sys: vcc5v0-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
	};

	vcc_1v8_shutdown: vcc-1v8-shutdown {
		compatible = "regulator-fixed";
		regulator-name = "vcc_power";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		gpio = <&gpio4 RK_PA2 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		pinctrl-names = "default";
		pinctrl-0 = <&shutdown_en>;
	};

	vcc5v0_hdmi: vcc5v0-hdmi {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_hdmi";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&gpio0 RK_PA5 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		pinctrl-names = "default";
		pinctrl-0 = <&hdmi_en>;
	};

	vcc3v3_wifi: vcc3v3-wifi {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_wifi";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio2 RK_PC7 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <5000>;
		pinctrl-names = "default";
		pinctrl-0 = <&usb_wifi_power_en>;
	};

	wifi_chip_en: wifi-chip-en {
		compatible = "regulator-fixed";
		regulator-name = "wifi_chip_en";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio2 RK_PD1 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <5000>;
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_chip_en_pin>;
	};
};

&combphy0_ps {
	status = "okay";
};

&combphy1_psu {
	status = "okay";
};

&i2c6 {
	fusb301@25 {
		compatible = "onsemi,fusb301";
		reg = <0x25>;
		interrupt-parent = <&gpio3>;
		interrupts = <RK_PD4 IRQ_TYPE_LEVEL_LOW>;
		int-n-gpios = <&gpio3 RK_PD4 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&usbc0_int>;

		connector {
			port {
				fusb_p0: endpoint {
					remote-endpoint = <&dwc3_0_role_switch>;
				};
			};
		};
	};
};

&pcie0 {
	reset-gpios = <&gpio2 RK_PB4 GPIO_ACTIVE_HIGH>;
	rockchip,skip-scan-in-resume;
	status = "okay";
};

&pinctrl {
	shutdown {
		shutdown_en: shutdown-en {
			rockchip,pins = <4 RK_PA2 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	hdmi {
		hdmi_en: hdmi-en {
			rockchip,pins = <0 RK_PA5 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	usb-typec {
		usbc0_int: usbc0-int {
			rockchip,pins = <3 RK_PD4 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	wifi {
		usb_wifi_power_en: usb-wifi-power-en {
			rockchip,pins = <2 RK_PC7 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		wifi_chip_en_pin: wifi-chip-en-pin {
			rockchip,pins = <2 RK_PD1 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

&u2phy0 {
	status = "okay";
};

&u2phy0_otg {
	status = "okay";
};

&u2phy1 {
	status = "okay";
};

&u2phy1_otg {
	status = "okay";
};

&usb_drd0_dwc3 {
	dr_mode = "otg";
	usb-role-switch;
	status = "okay";

	port {
		dwc3_0_role_switch: endpoint {
			remote-endpoint = <&fusb_p0>;
		};
	};
};

&usb_drd1_dwc3 {
	dr_mode = "host";
	status = "okay";
};

&usbdp_phy {
	rockchip,dp-lane-mux = <2 3>;
	status = "okay";
};
