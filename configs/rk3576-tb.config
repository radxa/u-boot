# CONFIG_BUTTON_GPIO is not set
# CONFIG_MTD is not set
# CONFIG_ROCKCHIP_META is not set
# CONFIG_SPL_AB is not set
# CONFIG_SPL_CRYPTO_MANAGER is not set
# CONFIG_SPL_GZIP is not set
# CONFIG_SPL_KERNEL_BOOT_PREBUILT is not set
# CONFIG_SPL_MTD is not set
# CONFIG_SPL_PARTITION_UUIDS is not set
# CONFIG_SPL_PINCTRL is not set
# CONFIG_SPL_ROCKCHIP_SECURE_OTP is not set
# CONFIG_SPL_RSA is not set
# CONFIG_SPL_SPI is not set
CONFIG_BASE_DEFCONFIG="rk3576_defconfig"
CONFIG_DEBUG_UART_SKIP_INIT=y
CONFIG_DEFAULT_DEVICE_TREE="rockchip/rk3576-tb"
CONFIG_OF_LIST="rockchip/rk3576-tb"
CONFIG_OF_SPL_REMOVE_PROPS="pinctrl-0 pinctrl-names clock-names interrupt-parent assigned-clocks assigned-clock-rates assigned-clock-parents"
CONFIG_ROCKCHIP_EMMC_IOMUX=y
CONFIG_SPL_ADC=y
CONFIG_SPL_BUTTON=y
CONFIG_SPL_BUTTON_ADC=y
CONFIG_SPL_KERNEL_BOOT=y
CONFIG_SYS_LOAD_ADDR=0x45480000
