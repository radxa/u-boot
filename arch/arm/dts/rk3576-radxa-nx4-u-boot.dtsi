#include <dt-bindings/input/input.h>
#include "rk3576-u-boot.dtsi"

/ {
	chosen {
		u-boot,spl-boot-order = &sdhci, "same-as-spl";
	};
};

&emmc_bus8 {
	bootph-all;
};

&emmc_clk {
	bootph-all;
};

&emmc_cmd {
	bootph-all;
};

&emmc_strb {
	bootph-all;
};

&emmc_rstnout {
	bootph-all;
};

&i2c6 {
	bootph-all;
};

&i2c6m3_xfer {
	bootph-all;
};

&eeprom {
	bootph-all;
};

&pcfg_pull_none_smt {
	bootph-all;
};

&sdmmc {
	status = "disabled";
};

&sfc0 {
	/* FSPI0 shares its pins with the NX4 eMMC. */
	status = "disabled";
};

&spi_nand {
	status = "disabled";
};

&spi_nor {
	status = "disabled";
};

&ufs {
	status = "disabled";
};
